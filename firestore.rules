rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is accessing their own user data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Student Profile Rules
    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && 
        request.resource.data.userId == userId;
      allow delete: if false; // Profiles shouldn't be deleted by clients
    }
    
    // Quiz Attempt Rules
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Quiz attempts are immutable once submitted
    }
    
    // Leaderboard Rules
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if false;
    }
  }
}
